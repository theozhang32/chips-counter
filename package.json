{
  "name": "chips-counter",
  "version": "1.0.0",
  "description": "德州扑克筹码计数器 API",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "test:unit": "node --test test/quickBets.test.js",
    "verify": "node src/scripts/verifyConsistency.js",
    "bench": "node src/scripts/bench.js",
    "lint": "eslint .",
    "format": "prettier --write src test *.js *.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.0",
    "koa": "^3.2.1",
    "mysql2": "^3.11",
    "node-cron": "^4.6.0",
    "sequelize": "^6.37.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
